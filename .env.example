# Application
APP_NAME=KineticGraph-Vectra
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional explicit judge configuration. OPENAI_API_KEY remains supported for
# backward compatibility, but OPENROUTER_API_KEY takes precedence for RAGAS.
OPENROUTER_API_KEY=
RAGAS_JUDGE_PROVIDER=openrouter
RAGAS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter-compatible default model
LLM_MODEL=qwen/qwen3.6-27b
GENERATION_TEMPERATURE=0.0
FAITHFULNESS_CRITIC_MODEL=qwen/qwen3.6-27b
FAITHFULNESS_CRITIC_TEMPERATURE=0.0

# ChromaDB Configuration
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=kinetic_vectors

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Generate a unique secret, for example: openssl rand -base64 32
NEO4J_PASSWORD=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# RRF Configuration
RRF_K=60
MAX_RESULTS=10

# Context precision controls
CONTEXT_TOP_K=6
RETRIEVAL_CANDIDATE_LIMIT=25
RETRIEVAL_DEDUP_THRESHOLD=0.95
GRAPH_MAX_HOPS=2
# For higher-quality multilingual reranking, try BAAI/bge-reranker-v2-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MIN_RELEVANCE=0.20
FUSION_VECTOR_WEIGHT=1.0
FUSION_GRAPH_WEIGHT=1.0
FUSION_LEXICAL_WEIGHT=0.7

# LangSmith Tracing (optional — leave blank to use local-log mode)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kinegraph-vectra
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Metrics Database (optional — defaults to SQLite eval/metrics.db)
# For production set to a PostgreSQL URL: postgresql://user:pass@host/db
DATABASE_URL=

# LiteParse — self-hosted local document parsing service
# Inside Docker Compose this is automatically set to http://liteparse:5000
# For local development (outside Docker) start the container manually on port 5000
PARSER_URL=http://localhost:5707
PARSER_TIMEOUT_SECONDS=120
